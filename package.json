{
  "name": "codeambers-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build && npm --workspace backend run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --workspace backend run start",
    "typecheck": "npm --workspace frontend run typecheck",
    "lint": "npm --workspace frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
